# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server only — never commit real values
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin: `npm run hash-password -- yourpassword` → 출력을 그대로 (로컬은 \$ 로 이스케이프 가능)
# Vercel 환경변수에는 $2b$10$... 형태만 넣기 — 따옴표·백슬래시 없이
ADMIN_PASSWORD_HASH=
# Min 32 random chars for JWT signing
ADMIN_SESSION_SECRET=

# Owner notifications (optional until configured)
OWNER_EMAIL=owner@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="하얀 개 마을 <noreply@example.com>"

# Google Calendar (optional — leave empty to skip)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Public site URL (for OAuth redirect base in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
