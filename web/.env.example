# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server only — never commit real values
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin — 둘 중 하나만 설정 (ADMIN_PASSWORD 가 있으면 평문이 우선, 입장 게이트 SITE_GATE_PASSWORD 와 동일한 방식)
ADMIN_PASSWORD=
# 또는 bcrypt: `npm run hash-password -- yourpassword` → $2b$10$... 한 줄
ADMIN_PASSWORD_HASH=
# Min 32 random chars for JWT signing
ADMIN_SESSION_SECRET=

# 사전 오픈 입장 게이트 — 값이 있으면 링크로 들어온 방문자에게 비밀번호 요구 (정식 오픈 시 비우기)
SITE_GATE_PASSWORD=

# Owner notifications (optional until configured)
OWNER_EMAIL=owner@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="하얀 개 마을 <noreply@example.com>"

# Google Calendar (optional — leave empty to skip)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Public site URL (for OAuth redirect base in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
